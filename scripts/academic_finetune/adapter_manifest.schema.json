{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiral.local/schemas/academic-adapter-v1.json",
  "title": "Spiral Academic MLX Adapter Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "prompt_contract",
    "base_model",
    "adapter",
    "training",
    "dataset",
    "environment",
    "runtime"
  ],
  "properties": {
    "schema_version": {"const": "spiral.academic-adapter.v1"},
    "profile_id": {"const": "academic-hep-pubmed-v1"},
    "prompt_contract": {"const": "spiral.academic-plan-prose.v1"},
    "base_model": {
      "type": "object",
      "required": ["model_id", "revision", "model_type", "architecture", "config_sha256", "weight_inventory_sha256", "weight_files", "quantization"],
      "properties": {
        "model_id": {"const": "mlx-community/Qwen3.8-27B-4bit"},
        "revision": {"const": "3e6447f082e89cc7f0bc6e5441afd38dfce760ff"},
        "model_type": {"const": "qwen3_5"},
        "architecture": {"const": "Qwen3_5ForConditionalGeneration"},
        "config_sha256": {"const": "14b65a0ee06517060a6bbd979bb1a8ff54e7b304b1a1f01d54344b88b8285e85"},
        "weight_index_sha256": {"const": "13b840162b4cb35c66fef7df072f7dbb4717908204364f5e5d9f9655a2758fa8"},
        "weight_inventory_sha256": {"const": "8126a3fd4aef3346254965791eedc5a5468bf7fcf46bdd95ef29dd13266ed589"},
        "weight_files": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {"const": {"path": "model-00001-of-00003.safetensors", "size_bytes": 5343268662, "sha256": "6cc1508e96fb5d0865dfd5753a79f4ec60651bf3e2a82844a7e8ae9c60528c0d"}},
            {"const": {"path": "model-00002-of-00003.safetensors", "size_bytes": 5354185130, "sha256": "83f2a20ca8058f486a3634a27faf99587f4cd3c156a83dee34fb99e6ac178670"}},
            {"const": {"path": "model-00003-of-00003.safetensors", "size_bytes": 5357087557, "sha256": "31b8c91ef899f79efaaa69e3d2c096f6e2ebeb2ff20e29222abbd9ebc79e560a"}}
          ]
        },
        "quantization": {
          "type": "object",
          "required": ["bits", "group_size", "mode"],
          "properties": {"bits": {"const": 4}, "group_size": {"const": 64}, "mode": {"const": "affine"}}
        }
      }
    },
    "adapter": {
      "type": "object",
      "required": ["path", "format", "sha256", "sha256_semantics", "required_files"],
      "properties": {
        "path": {"type": "string"},
        "format": {"const": "mlx_lm_lora"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "sha256_semantics": {"type": "string"},
        "required_files": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["path", "size_bytes", "sha256"],
            "properties": {
              "path": {"enum": ["adapter_config.json", "adapters.safetensors"]},
              "size_bytes": {"type": "integer", "minimum": 1},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "training": {
      "type": "object",
      "required": [
        "seed", "completion_only_loss", "trainable_layers",
        "trainable_target_paths", "target_path_counts",
        "corpus_manifest_path", "corpus_manifest_sha256"
      ],
      "properties": {
        "seed": {"type": "integer"},
        "completion_only_loss": {"const": true},
        "corpus_manifest_path": {"type": "string", "minLength": 1},
        "corpus_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "dataset": {
      "type": "object",
      "required": [
        "dataset_manifest_path", "manifest_sha256", "source_corpus_sha256",
        "source_corpus_file_sha256", "split_sha256"
      ],
      "properties": {
        "dataset_manifest_path": {"type": "string", "minLength": 1},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "source_corpus_sha256": {"$ref": "#/$defs/sha256"},
        "source_corpus_file_sha256": {"$ref": "#/$defs/sha256"},
        "split_sha256": {"type": "object"}
      }
    },
    "environment": {"type": "object"},
    "runtime": {
      "type": "object",
      "required": ["provider", "model", "base_url", "transport_adapter"],
      "properties": {
        "provider": {"const": "mlx_lm"},
        "model": {"const": "qwen3.8-27b-academic"},
        "base_url": {"type": "string", "const": "http://127.0.0.1:8080/v1"},
        "transport_adapter": {"const": "openai-compatible"},
        "default_adapter_strength": {"const": 1.0}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
